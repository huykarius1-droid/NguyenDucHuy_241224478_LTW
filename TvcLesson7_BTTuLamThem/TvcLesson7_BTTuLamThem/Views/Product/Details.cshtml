@model TvcLesson7_BTTuLamThem.Models.Product
<h2>Chi tiết sản phẩm</h2>
<img src="~/products/@Model.Image" width="200" />
<dl class="row mt-3">
    <dt class="col-sm-2">Tên</dt>
    <dd class="col-sm-10">@Model.Name</dd>
    <dt class="col-sm-2">Danh mục</dt>
    <dd class="col-sm-10">@ViewBag.CategoryName</dd>
    <dt class="col-sm-2">Giá</dt>
    <dd class="col-sm-10">@Model.Price?.ToString("N0")</dd>
    <dt class="col-sm-2">Giá KM</dt>
    <dd class="col-sm-10">@Model.SalePrice?.ToString("N0")</dd>
    <dt class="col-sm-2">Mô tả</dt>
    <dd class="col-sm-10">@Model.Description</dd>
</dl>
<a asp-action="Index">Quay lại</a>